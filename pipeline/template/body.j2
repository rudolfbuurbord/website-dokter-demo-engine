{% set tel %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{% endset %}
{% set arrow %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{% endset %}
{% set check %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>{% endset %}
<body class="t-{{theme}}{% if lowacc %} lowacc{% endif %}{% if alldark %} alldark{% endif %}">


<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a class="brand{% if plate %} plate{% endif %}{% if mplate %} mplate{% endif %}" href="#top" aria-label="{{m.name}}, naar boven"><img class="lg-d" src="logos/logo-licht.png" alt="{{m.name}}"><img class="lg-l" src="logos/logo.png" alt="" aria-hidden="true"></a>
    <nav aria-label="Hoofdmenu"><ul>
      <li><a href="#diensten">Schilderwerk</a></li>
      <li><a href="#voor-wie">Voor wie</a></li>
      <li><a href="#projecten">Projecten</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul></nav>
    <div class="nav-r">
      <a class="nav-tel" href="tel:{{m.phone_href}}" aria-label="Bel {{m.phone}}"><span class="live" id="live"></span><span class="n">{{m.phone}}</span><span class="ph-ic">{{tel}}</span></a>
      <a class="nav-cta" href="#offerte">Offerte aanvragen</a>
    </div>
  </div>
</header>

<main id="top">
<section class="hero">
  <div class="wrap hero-in">
    <span class="h-pill"><span class="live" id="live2"></span><b>{{m.name}}</b> · {{h.pill}}</span>
    <h1 class="h1"><span class="l1">{{h.line1}}</span>
      <span class="rollword" aria-label="{{h.word}}"><span class="ghost" aria-hidden="true">{{h.word}}</span><span class="paint" aria-hidden="true">{{h.word}}</span>
        <span class="roller" aria-hidden="true"><svg viewBox="0 0 60 110"><defs><linearGradient id="cyl" x1="0" x2="1"><stop offset="0" stop-color="{{c.rollerDark}}"/><stop offset=".35" stop-color="{{c.rollerLight}}"/><stop offset=".6" stop-color="{{c.accent}}"/><stop offset="1" stop-color="{{c.rollerDark}}"/></linearGradient></defs>
          <rect x="4" y="2" width="26" height="80" rx="9" fill="url(#cyl)"/><rect x="4" y="2" width="26" height="80" rx="9" fill="none" stroke="rgba(0,0,0,.15)"/>
          <path d="M30 42 H44 V96" fill="none" stroke="#cfc8bf" stroke-width="4" stroke-linecap="round"/>
          <rect x="38" y="88" width="13" height="40" rx="5" fill="{{c.cardD}}" stroke="rgba(255,255,255,.25)" stroke-width="1.5"/></svg></span>
      </span>
    </h1>
    <p class="h-sub">{{h.sub|safe}}</p>
    <div class="hero-ctas">
      <a class="btn btn-red" href="#offerte">Vraag een offerte aan {{arrow}}</a>
      <a class="btn btn-line" href="tel:{{m.phone_href}}">{{tel}}Bel {{m.phone}}</a>
    </div>
    <ul class="h-usp">{% for u in h.usps %}<li>{{check}}{{u}}</li>{% endfor %}</ul>
  </div>
  <div class="strip-wrap" aria-label="Recent werk van {{m.name}}"><div class="film-row"><div class="film" id="film"></div></div></div>
</section>

<section class="quote rv" id="spreuk"><div class="wrap"><p>{{q.before}} <span class="k">{{q.mark}}</span></p></div></section>

<section class="sec {{ 'dark' if theme=='donker' else 'lightsec' }}" id="projecten">
  <div class="wrap">
    <div class="shead"><div><span class="eyebrow">Projecten</span><h2>{{p.title|safe}}</h2></div><p class="lead">{{p.lead}}</p></div>
    <article class="feature rv">
      <div class="img"><img class="main" src="img/{{p.feature.img}}.webp" alt="{{p.feature.alt}}"><span class="badge1935"><span>{{p.feature.badge_small}}<b>{{p.feature.badge_big}}</b></span></span></div>
      <div class="txt">
        <span class="pill">{{p.feature.pill}}</span>
        <h3>{{p.feature.title}}</h3>
        <p>{{p.feature.text}}</p>
        <div class="tri">{% for t in p.feature.tri %}<figure><img src="img/{{t[0]}}.webp" alt="{{t[1]}}"><figcaption>{{t[1]}}</figcaption></figure>{% endfor %}</div>
      </div>
    </article>
    <div class="filters" role="group" aria-label="Filter projecten"><button aria-pressed="true" data-f="all">Alles</button>{% for f in p.filters %}<button aria-pressed="false" data-f="{{f[0]}}">{{f[1]}}</button>{% endfor %}</div>
    <div class="grid" id="grid"></div>
  </div>
</section>

<section class="sec {{ 'dark' if theme=='donker' else 'lightsec' }} cont" id="diensten">
  <div class="wrap"><div class="inner">
    <div class="shead"><div><span class="eyebrow">Wat wij voor u doen</span><h2>{{s.title|safe}}</h2></div><p class="lead">{{s.lead}}</p></div>
    <div class="srows" id="srows"></div>
  </div></div>
</section>

<section class="sec" id="voor-wie">
  <div class="wrap">
    <div class="shead"><div><span class="eyebrow">Voor wie werken wij?</span><h2>{{w.title|safe}}</h2></div><p class="lead">{{w.lead}}</p></div>
    <div class="who-grid">{% for k in w.cards %}
      <a class="who-card rv" href="#offerte" data-u="u{{loop.index}}"><img src="img/{{k.img}}.webp" alt="{{k.title}}" loading="lazy"><span class="no">0{{loop.index}}</span><div class="in"><h3>{{k.title}}</h3><p>{{k.text}}</p><span class="go">{{k.cta}} {{arrow}}</span></div></a>{% endfor %}
    </div>
  </div>
</section>

<section class="sec cont" id="werkwijze">
  <div class="wrap"><div class="inner">
    <div class="shead"><div><span class="eyebrow">Werkwijze</span><h2>{{ww.title|safe}}</h2></div><p class="lead">{{ww.lead}}</p></div>
    <div class="steps">{% for st in ww.steps %}
      <article class="step rv"><div class="ph"><img src="img/{{st.img}}.webp" alt="{{st.alt}}" loading="lazy" style="object-position:{{st.pos|default('50% 50%')}}"><span class="n">0{{loop.index}}</span></div><div class="bd"><h3>{{st.title}}</h3><p>{{st.text}}</p><div class="meta">{{st.meta}}</div></div></article>{% endfor %}
    </div>
  </div></div>
</section>

<section class="sec cont" id="keurmerken">
  <div class="wrap"><div class="inner">
    <div class="shead"><div><span class="eyebrow">Zekerheden</span><h2>{{z.title|safe}}</h2></div><p class="lead">{{z.lead}}</p></div>
    <div class="cgrid">{% for k in z.cards %}
      <div class="cert rv"><div class="lg"><div class="kvk"><small>{{k.small}}</small>{{k.big}}</div></div><h3>{{k.title}}{% if k.example %} <span class="tag">voorbeeld</span>{% endif %}</h3><p>{{k.text}}</p></div>{% endfor %}
    </div>
    <div class="brands" id="merken">
      <div><span class="eyebrow">Verfmerken</span><h3 style="margin-top:14px">Merken waarmee we werken</h3><p>Alleen professionele kwaliteit. <span class="tag">verfmerken: voorbeeld</span></p></div>
      <div class="bgrid">{% for b in ['sikkens.png','sigma.svg','histor.png','flexa-dark.svg','wijzonol.svg','repaircare.svg','graco.svg'] %}<div class="blogo rv"><img src="logos/{{b}}" alt="{{b.split('.')[0]|capitalize}}"></div>{% endfor %}</div>
    </div>
  </div></div>
</section>

<section class="sec cont" id="werkgebied">
  <div class="wrap"><div class="inner area-grid">
    <div>
      <span class="eyebrow">Werkgebied</span>
      <h2>{{a.title}}</h2>
      <p class="lead">{{a.lead}}</p>
      <div class="places">{% for pl in a.places %}<span>{{pl}}</span>{% endfor %}</div>
      <form class="pc" id="pcform" novalidate>
        <label for="pc" style="position:absolute;left:-9999px">Uw postcode</label>
        <input id="pc" inputmode="numeric" autocomplete="postal-code" placeholder="Uw postcode, bijv. {{a.pc_example}}">
        <button class="btn btn-ink" type="submit">Check</button>
      </form>
      <p class="pc-out" id="pcout" aria-live="polite"></p>
    </div>
    <div class="mapbox rv">
      <img src="img/kaart.webp" alt="Kaart van het werkgebied met een pin op {{m.city}}">
      <div class="radius" aria-hidden="true" style="left:{{a.map.x}}%;top:{{a.map.y}}%;width:{{a.map.d}}%;background:{{c.glowSoft}};border-color:{{c.accent}}"></div>
      <div class="pinpulse" aria-hidden="true" style="left:{{a.map.x}}%;top:{{a.map.y}}%"></div>
      <svg class="pin" style="left:{{a.map.x}}%;top:{{a.map.y}}%" viewBox="0 0 48 64" aria-hidden="true"><path d="M24 2C12 2 3 11 3 23c0 15 21 37 21 37s21-22 21-37C45 11 36 2 24 2z" fill="{{c.pin}}" stroke="#fff" stroke-width="3"/><circle cx="24" cy="23" r="8" fill="#fff"/></svg>
      <div class="pincard" style="left:calc({{a.map.x}}% + 30px);top:calc({{a.map.y}}% - 80px)"><b>{{m.name}}</b>{% if m.street %}{{m.street}}, {% endif %}{{m.city}}</div>
      <span class="osm">© OpenStreetMap-bijdragers</span>
    </div>
  </div></div>
</section>

<section class="sec dark" id="reviews">
  <div class="wrap shead">
    <div><span class="eyebrow">Reviews</span><h2>Wat klanten<br>zeggen.</h2></div>
    <div class="score"><b>{{r.score}}</b><div><span class="stars">★★★★★</span><br>{{r.label}}{% if r.example %}<br><span class="tag">voorbeeldscore · voorbeeldreviews</span>{% endif %}</div></div>
  </div>
  <div class="marquee"><div class="track" id="t1"></div><div class="track rev" id="t2"></div></div>
</section>

<section class="sec" id="offerte">
  <div class="wrap qf-grid">
    <div class="qf-side">
      <span class="eyebrow">Offerte</span>
      <h2>{{o.title}}</h2>
      <ul>{% for b in o.bullets %}<li>{{b}}</li>{% endfor %}</ul>
      <div class="contactcard"><img src="img/{{o.photo}}.webp" alt="{{m.name}} aan het werk"><div><b>Liever bellen?</b><a href="tel:{{m.phone_href}}">{{m.phone}}</a>{% if m.email %} · <a href="mailto:{{m.email}}">Mail</a>{% endif %}</div></div>
    </div>
    <form class="qf" id="qf" novalidate>
      <div id="qfFields">
        <label class="big" for="wat">Vertel kort wat er geschilderd moet worden</label>
        <div class="field" style="margin-top:0" id="f-wat"><textarea id="wat" placeholder="{{o.placeholder}}"></textarea><span class="emsg" id="e-wat"></span></div>
        <span class="lbl">Wat moet er gebeuren?</span>
        <div class="chips">{% for x in o.work %}<input type="checkbox" id="c{{loop.index}}"><label for="c{{loop.index}}">{{x}}</label>{% endfor %}</div>
        <span class="lbl">U bent</span>
        <div class="chips">{% for x in o.who %}<input type="radio" name="wie" id="u{{loop.index}}"{% if loop.first %} checked{% endif %}><label for="u{{loop.index}}">{{x}}</label>{% endfor %}</div>
        <div class="row2">
          <label class="field" id="f-naam"><span>Naam</span><input id="naam" autocomplete="name"><span class="emsg" id="e-naam"></span></label>
          <label class="field" id="f-tel"><span>Telefoonnummer</span><input id="tel" type="tel" inputmode="tel" autocomplete="tel" placeholder="06 12345678"><span class="emsg" id="e-tel"></span></label>
        </div>
        <div class="row2">
          <label class="field"><span>Postcode en plaats</span><input id="plaats" autocomplete="postal-code"></label>
          <label class="field"><span>E-mail</span><input id="mail" type="email" autocomplete="email"></label>
        </div>
        <label class="upload"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="15" rx="3"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8 5l1.5-2h5L16 5"/></svg><span id="upl">Foto's toevoegen (optioneel)</span><input type="file" id="files" accept="image/*" multiple></label>
        <button class="btn btn-red submit" type="submit">Offerte aanvragen {{arrow}}</button>
        <p class="fine">{{o.fine}}</p>
      </div>
      <div class="done" id="done" aria-live="polite">
        <div class="ck">{{check}}</div>
        <p class="big" id="doneT">Bedankt!</p>
        <p>We nemen snel contact op via <b id="doneTel"></b> voor een afspraak.</p>
        <p class="fine">Dit is een demo: er is niets verzonden.</p>
        <button class="btn btn-line" type="button" id="again" style="margin-top:18px">Nieuwe aanvraag</button>
      </div>
    </form>
  </div>
</section>

<section class="sec cont" id="faq">
  <div class="wrap"><div class="inner faq-grid">
    <div><span class="eyebrow">Veelgestelde vragen</span><h2>Vraag het de schilder.</h2><p class="lead" style="margin-bottom:28px">Tik op een vraag. Het antwoord komt meteen, net als in de app.</p><div class="qs" id="qs"></div></div>
    <div class="phone rv"><div class="phone-top"><img src="img/{{o.photo}}.webp" alt=""><div><b>{{m.name}}</b><small>● online · {{m.hours}}</small></div></div><div class="chat" id="chat" aria-live="polite"></div></div>
  </div></div>
</section>
</main>

<footer class="dark" id="contact">
  <div class="wrap">
    <div class="f-cta">
      <p class="f-kicker">{{f.kicker}}</p>
      <p class="f-name" aria-label="{{f.name}}">{{f.name}}<i></i></p>
      <div class="f-btns"><a class="btn btn-red" href="#offerte">Offerte aanvragen</a><a class="btn btn-line" href="tel:{{m.phone_href}}">Bel {{m.phone}}</a></div>
    </div>
    <div class="f-cols">
      <div><h4>Schilderwerk</h4><ul>{% for x in f.services %}<li><a href="#diensten">{{x}}</a></li>{% endfor %}</ul></div>
      <div><h4>Contact</h4><ul><li><a class="f-big" href="tel:{{m.phone_href}}">{{m.phone}}</a></li>{% if m.email %}<li><a href="mailto:{{m.email}}">{{m.email}}</a></li>{% endif %}<li><a href="#offerte">Offerte aanvragen</a></li></ul></div>
      <div><h4>Adres</h4><p>{{m.name}}<br>{% if m.street %}{{m.street}}<br>{% endif %}{{m.postcode}} {{m.city}}</p><p style="margin-top:12px">{{m.hours}}</p></div>
      <div><h4>Werkgebied</h4><ul>{% for x in a.places[:6] %}<li><a href="#werkgebied">{{x}}</a></li>{% endfor %}</ul></div>
    </div>
    <div class="f-legal"><span>© 2026 {{m.name}} · Privacyverklaring · Algemene voorwaarden</span><span>Demo-ontwerp door <b>De Website Dokters</b> · {{f.example_note}}</span></div>
  </div>
</footer>

<nav class="mbar" id="mbar" aria-label="Snel contact"><a class="c" href="tel:{{m.phone_href}}">Bellen</a><a class="o" href="#offerte">Offerte aanvragen</a></nav>

<div class="lightbox" id="lb" role="dialog" aria-modal="true" aria-label="Projectfoto">
  <button class="lb-x" id="lbx" aria-label="Sluiten">×</button><button class="lb-nav lb-prev" id="lbp" aria-label="Vorige">‹</button>
  <div><img id="lbimg" alt=""><p class="cap" id="lbcap"></p></div><button class="lb-nav lb-next" id="lbn" aria-label="Volgende">›</button>
</div>
<a class="demotag" href="#contact">Demo-ontwerp · <b>De Website Dokters</b></a>
<script>window.D={{js|tojson}};</script>
