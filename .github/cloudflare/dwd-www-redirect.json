{
  "ref": "dwd_www_to_apex",
  "description": "DWD: redirect www to the canonical HTTPS hostname",
  "expression": "(http.host eq \"www.dewebsitedokters.nl\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://dewebsitedokters.nl\", http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
